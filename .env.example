# Security Scanner Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=security_scanner

# API Authentication
# Generate secure API keys (comma-separated for multiple keys)
API_KEYS=your-secure-api-key-1,your-secure-api-key-2

# Rate Limiting
# Maximum scans per hour per IP
MAX_SCANS_PER_HOUR=10

# Security Settings
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Scanner Settings
# Maximum concurrent requests for DDoS test (max 10)
MAX_CONCURRENT_REQUESTS=5

# Session Secret (generate a random string)
SESSION_SECRET=your-random-session-secret-here
